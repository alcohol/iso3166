<?xml version="1.0" encoding="UTF-8"?>
<!--
    Targets the PHPUnit 10+ configuration format. PHPUnit 9 (only installed on
    PHP 7.4/8.0 or with prefer-lowest) still runs this file, but will report
    schema validation warnings. Code coverage is only collected in CI
    (see .github/workflows/ci.yaml), pass coverage options to run it locally.
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    cacheDirectory=".phpunit.cache"
    colors="true"
    stderr="true"
>

    <testsuites>
        <testsuite name="ISO3166 Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
    </source>

</phpunit>
